{
  "$defs": {
    "AgentDataBackfillStage": {
      "description": "Finite stages in the bounded per-user corpus backfill.",
      "enum": [
        "knowledge",
        "content",
        "news",
        "chats",
        "briefings"
      ],
      "title": "AgentDataBackfillStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "before_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before Id"
    },
    "stage": {
      "$ref": "#/$defs/AgentDataBackfillStage",
      "default": "knowledge"
    },
    "user_id": {
      "exclusiveMinimum": 0,
      "title": "User Id",
      "type": "integer"
    }
  },
  "required": [
    "user_id"
  ],
  "title": "AgentDataBackfillPayload",
  "type": "object"
}
