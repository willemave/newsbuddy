# Local native PostgreSQL development runtime
PORT=8000
DATABASE_URL=postgresql://newsly:change-me@127.0.0.1:5432/newsly

# Rust SQLx pool tuning
NEWSLY_RUST_DATABASE_MAX_CONNECTIONS=20
NEWSLY_RUST_DATABASE_MIN_CONNECTIONS=0
NEWSLY_RUST_DATABASE_ACQUIRE_TIMEOUT_MS=5000

# Application
ENVIRONMENT=development
# Required in production. Keep this to the public HTTPS origin with no path.
# PUBLIC_BASE_URL=https://news.willemsavenue.com
NEWSLY_RUST_LOG_FORMAT=pretty
RUST_LOG=newsly_api=info,newsly_worker=info,newsly_scheduler=info

# Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_PASSWORD=your-admin-password-here
APPLE_TEAM_ID=
APPLE_KEY_ID=
# ES256 Sign in with Apple private key; use \n escapes when stored on one line.
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=org.willemaw.newsly
JWT_ALGORITHM=HS256

# Storage defaults for local development
MEDIA_BASE_DIR=./data/media
LOGS_BASE_DIR=./logs
IMAGES_BASE_DIR=./data/images

# Canonical content body storage
# local = filesystem, s3_compatible = AWS S3 or Cloudflare R2
CONTENT_BODY_STORAGE_PROVIDER=local
CONTENT_BODY_LOCAL_ROOT=./data/content_bodies
CONTENT_BODY_STORAGE_PREFIX=content
CONTENT_BODY_STORAGE_BUCKET=
CONTENT_BODY_STORAGE_ENDPOINT=
CONTENT_BODY_STORAGE_REGION=
CONTENT_BODY_STORAGE_ACCESS_KEY=
CONTENT_BODY_STORAGE_SECRET_KEY=
CONTENT_BODY_STORAGE_TIMEOUT_SECONDS=30

# Podcast media processing scratch space
PODCAST_SCRATCH_DIR=./data/scratch
PERSONAL_MARKDOWN_ROOT=./data/personal_markdown

# Native media worker / YouTube
YT_DLP_BINARY=yt-dlp
YOUTUBE_COOKIES_PATH=secrets/youtube_cookies.txt
YOUTUBE_PLAYER_CLIENT=mweb
YOUTUBE_PO_TOKEN_PROVIDER=bgutilhttp
YOUTUBE_PO_TOKEN_BASE_URL=http://127.0.0.1:4416

# LLM Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
INFOGRAPHIC_GENERATION_PROVIDER=runware
INFOGRAPHIC_GENERATION_MODEL=
INFOGRAPHIC_GENERATION_FALLBACK_MODEL=
RUNWARE_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=your_firecrawl_key
FIRECRAWL_CREDIT_COST_USD=0.00083

# ElevenLabs narration and podcast speech
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional distinct podcast voices; both fall back to ELEVENLABS_TTS_VOICE_ID.
ELEVENLABS_PODCAST_HOST_VOICE_ID=
ELEVENLABS_PODCAST_GUEST_VOICE_ID=
ELEVENLABS_NARRATION_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_NARRATION_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_NARRATION_TTS_SPEED=1.0
ELEVENLABS_AUDIO_EPISODE_TTS_MAX_WORKERS=4

# X API (official v2 + OAuth bookmark sync)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
X_TOKEN_ENCRYPTION_KEY=
X_BOOKMARK_SYNC_ENABLED=false
X_SYNC_MIN_INTERVAL_MINUTES=60
X_BOOKMARK_SYNC_MIN_INTERVAL_MINUTES=60

# Reddit API access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=newsly-scraper/2.0 (+https://newsly.app)

# Persistent agent VM execution
E2B_API_KEY=
NEWSLY_AGENT_VM_TEMPLATE_ID=newsly-agent
LLM_TASK_SANDBOX_TIMEOUT_SECONDS=300

# Isolated database-free Crawl4AI extractor
DOCUMENT_EXTRACTOR_SHARED_SECRET=replace-with-a-separate-random-secret
DOCUMENT_EXTRACTOR_URL=http://127.0.0.1:8200
DOCUMENT_EXTRACTOR_TIMEOUT_SECONDS=190
DOCUMENT_EXTRACTOR_MAX_RESPONSE_BYTES=2500000
