# Local native PostgreSQL development runtime
PORT=8000
DATABASE_URL=postgresql+psycopg://newsly:change-me@127.0.0.1:5432/newsly

# Database pool tuning for the app -> local Postgres connection
DATABASE_POOL_SIZE=20

# Application
APP_NAME="News Aggregator"
ENVIRONMENT=development
# Required in production. Keep this to the public HTTPS origin with no path.
# PUBLIC_BASE_URL=https://news.willemsavenue.com
DEBUG=false
LOG_LEVEL=INFO
# Production must set explicit origins, for example:
# CORS_ALLOW_ORIGINS=https://news.willemsavenue.com
CORS_ALLOW_ORIGINS=*

# Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
ADMIN_PASSWORD=your-admin-password-here
APPLE_TEAM_ID=
APPLE_KEY_ID=
# ES256 Sign in with Apple private key; use \n escapes when stored on one line.
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=org.willemaw.newsly
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=90

# Workers
MAX_WORKERS=5
WORKER_TIMEOUT_SECONDS=300
CHECKOUT_TIMEOUT_MINUTES=30
QUEUE_BACKPRESSURE_MAX_PENDING_CONTENT=150
QUEUE_BACKPRESSURE_MAX_PENDING_PROCESS_NEWS_ITEM=75

# Storage defaults for local development
MEDIA_BASE_DIR=./data/media
LOGS_BASE_DIR=./logs
IMAGES_BASE_DIR=./data/images

# Canonical content body storage
# local = filesystem, s3_compatible = AWS S3 or Cloudflare R2
CONTENT_BODY_STORAGE_PROVIDER=local
CONTENT_BODY_LOCAL_ROOT=./data/content_bodies
CONTENT_BODY_STORAGE_PREFIX=content
CONTENT_BODY_STORAGE_BUCKET=
CONTENT_BODY_STORAGE_ENDPOINT=
CONTENT_BODY_STORAGE_REGION=
CONTENT_BODY_STORAGE_ACCESS_KEY=
CONTENT_BODY_STORAGE_SECRET_KEY=
CONTENT_BODY_STORAGE_TIMEOUT_SECONDS=30

# Podcast media processing scratch space
PODCAST_SCRATCH_DIR=./data/scratch
PERSONAL_MARKDOWN_ROOT=./data/personal_markdown

# LLM Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Native PDF extraction includes rendered page images for diagrams and scanned text.
PDF_EXTRACTION_MODEL=gpt-5.6-luna
INFOGRAPHIC_GENERATION_PROVIDER=google
INFOGRAPHIC_GENERATION_MODEL=
INFOGRAPHIC_GENERATION_FALLBACK_MODEL=
RUNWARE_API_KEY=
CEREBRAS_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=your_firecrawl_key
FIRECRAWL_CREDIT_COST_USD=0.00083

# Podcast Online Search (optional, recommended for best results)
LISTEN_NOTES_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT=newsly/1.0
PODCAST_SEARCH_CACHE_TTL_SECONDS=300
PODCAST_SEARCH_PROVIDER_TIMEOUT_SECONDS=6
PODCAST_SEARCH_CIRCUIT_BREAKER_FAILURES=3
PODCAST_SEARCH_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# ElevenLabs narration and podcast speech
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional distinct podcast voices; both fall back to ELEVENLABS_TTS_VOICE_ID.
ELEVENLABS_PODCAST_HOST_VOICE_ID=
ELEVENLABS_PODCAST_GUEST_VOICE_ID=
ELEVENLABS_NARRATION_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_NARRATION_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_NARRATION_TTS_SPEED=1.0
ELEVENLABS_AUDIO_EPISODE_TTS_MAX_WORKERS=4

# X API (official v2 + OAuth bookmark sync)
X_APP_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
X_TOKEN_ENCRYPTION_KEY=
X_BOOKMARK_SYNC_ENABLED=false
X_SYNC_MIN_INTERVAL_MINUTES=60
X_BOOKMARK_SYNC_MIN_INTERVAL_MINUTES=60

# Reddit (PRAW script flow)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_READ_ONLY=true
REDDIT_USER_AGENT=news-app/1.0 (by u/yourname)

# Whisper Transcription Settings
USE_LOCAL_WHISPER=true
WHISPER_MODEL_SIZE=base  # Options: tiny, base, small, medium, large
WHISPER_DEVICE=auto      # Options: auto, cpu, cuda, mps

# Personal markdown chat sandbox
CHAT_SANDBOX_PROVIDER=e2b
E2B_API_KEY=
CHAT_SANDBOX_TEMPLATE=
CHAT_SANDBOX_LIBRARY_ROOT=/tmp/newsly/personal_markdown
